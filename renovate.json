{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Keep Helm chart dependencies, Kubernetes/k3s versions, and CI tools pinned and updated.",
  "extends": [
    "config:recommended"
  ],
  "helmv3": {
    "managerFilePatterns": [
      "/(^|/)(?:charts|addons)/[^/]+/Chart\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update tools annotated with # renovate: datasource=... depName=... in CI workflows",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s*\\n\\s*[A-Z0-9_]+=(?<currentValue>[^\\s']+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Update versions annotated with # renovate: in mise.toml (non-mise tools such as helm plugins)",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)(?:\\s+extractVersion=(?<extractVersion>[^\\s]+))?\\s*\\n\\s*[A-Z0-9_]+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Pinned mise binary version in CI workflows and the devcontainer",
      "managerFilePatterns": [
        "/^\\.github/workflows/[^/]+\\.ya?ml$/",
        "/^\\.devcontainer/devcontainer\\.json$/"
      ],
      "matchStrings": [
        "jdx/mise-action@[0-9a-f]{40}[^\\n]*\\n(?:\\s+[a-z_]+:[^\\n]*\\n)*?\\s+version:\\s*(?<currentValue>[0-9.]+)",
        "\"MISE_VERSION\":\\s*\"v(?<currentValue>[0-9.]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "jdx/mise",
      "extractVersionTemplate": "^v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update k3s kubernetesVersion in installation cluster files",
      "managerFilePatterns": [
        "/^installations/[^/]+/clusters/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "kubernetesVersion:\\s*(?<currentValue>v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "k3s-io/k3s"
    },
    {
      "customType": "regex",
      "description": "koorikla/ci reusable workflow commit Kyverno trusts for keyless signatures (kyverno-policies imageVerification.github.workflowRef, tracks tag v1); bump together with the app repos' `uses: koorikla/ci/...@<sha> # v1`",
      "managerFilePatterns": [
        "/^addons/kyverno-policies/values\\.yaml$/",
        "/^installations/[^/]+/addons/kyverno-policies/[^/]+\\.ya?ml$/"
      ],
      "matchStrings": [
        "workflowRef:\\s*\"?(?<currentDigest>[0-9a-f]{40})\"?\\s*#\\s*(?<currentValue>v[0-9][^\\s]*)"
      ],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "koorikla/ci"
    },
    {
      "customType": "regex",
      "description": "Crossplane packages (Functions, upjet family providers) pinned as xpkg.crossplane.io/<org>/<pkg>:<tag>@<digest> in addon crossplane; bump a provider family together (same tag for every member)",
      "managerFilePatterns": [
        "/^addons/crossplane/values\\.yaml$/"
      ],
      "matchStrings": [
        "(?<depName>xpkg\\.crossplane\\.io/[a-z0-9-]+/[a-z0-9-]+):(?<currentValue>v[0-9][^@\\s]*)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
