{{- /* Cloud backends: the <name>-bucket Secret without keys - apps use workload identity, no static cloud credentials. */}}
{{- if has $backend (list "aws-s3" "gcp-storage" "azure-blob") }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ $name }}-bucket
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
    gotemplating.fn.crossplane.io/ready: "True"
type: Opaque
stringData:
  endpoint: {{ $endpoint }}
  bucket: {{ $id }}
  region: {{ $region }}
  accessKeyId: ""
  secretAccessKey: ""
{{- end }}
