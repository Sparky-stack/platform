{{- /* The <name>-bucket Secret: also the RustFS user's credentials (label: the operator re-reconciles the Tenant on change). */}}
{{- if eq $backend "rustfs" }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-bucket
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-bucket
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      metadata:
        labels: { rustfs.tenant: {{ $name }} }
      data:
        endpoint: {{ $endpoint }}
        bucket: {{ $id }}
        region: {{ $region }}
        accessKeyId: app
        secretAccessKey: '{{ $o }} .password {{ $c }}'
  dataFrom:
    - sourceRef: { generatorRef: { apiVersion: generators.external-secrets.io/v1alpha1, kind: Password, name: {{ $name }}-rustfs-app } }
{{- end }}
