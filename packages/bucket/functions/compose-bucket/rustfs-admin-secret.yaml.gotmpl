{{- /* VERIFY: credsSecret key names accesskey / secretkey. */}}
{{- if eq $backend "rustfs" }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-rustfs-admin
  annotations:
    {{ setResourceNameAnnotation "admin-secret" }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-rustfs-admin
    template:
      data: { accesskey: admin, secretkey: '{{ $o }} .password {{ $c }}' }
  dataFrom:
    - sourceRef: { generatorRef: { apiVersion: generators.external-secrets.io/v1alpha1, kind: Password, name: {{ $name }}-rustfs-admin } }
{{- end }}
