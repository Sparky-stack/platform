{{- /* rustfs: ESO generates the tenant admin key (<name>-rustfs-admin, never handed to the app) and the app user's secret key. */}}
{{- if eq $backend "rustfs" }}
{{- range $who := list "admin" "app" }}
---
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{ $name }}-rustfs-{{ $who }}
  annotations:
    {{ setResourceNameAnnotation (printf "password-%s" $who) }}
    gotemplating.fn.crossplane.io/ready: "True"
spec: { length: 40, digits: 10, symbols: 0, noUpper: false, allowRepeat: true }
{{- end }}
{{- end }}
