{{- /* Canned policy of the app user: this bucket only. */}}
{{- if eq $backend "rustfs" }}
---
apiVersion: v1
kind: ConfigMap
metadata:
  name: {{ $name }}-bucket-policy
  labels: { rustfs.tenant: {{ $name }} }
  annotations:
    {{ setResourceNameAnnotation "policy" }}
    gotemplating.fn.crossplane.io/ready: "True"
data:
  policy.json: |
    {"Version": "2012-10-17", "Statement": [
      {"Effect": "Allow", "Action": ["s3:GetBucketLocation", "s3:ListBucket", "s3:ListBucketVersions"], "Resource": ["arn:aws:s3:::{{ $id }}"]},
      {"Effect": "Allow", "Action": ["s3:GetObject*", "s3:PutObject*", "s3:DeleteObject*", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"], "Resource": ["arn:aws:s3:::{{ $id }}/*"]}]}
{{- end }}
