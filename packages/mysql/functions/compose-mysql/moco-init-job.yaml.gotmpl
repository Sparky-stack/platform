{{- /* moco has no database/user CRD: this Job creates both with idempotent SQL as moco-admin (operator Secret moco-<name>, key ADMIN_PASSWORD), retrying until the cluster answers. Pod Security restricted. */}}
{{- if eq $backend "moco" }}
---
apiVersion: batch/v1
kind: Job
metadata:
  name: {{ $name }}-mysql-init
  annotations:
    {{ setResourceNameAnnotation "init-user" }}
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  backoffLimit: 30
  template:
    spec:
      restartPolicy: OnFailure
      securityContext: { runAsNonRoot: true, runAsUser: 10000, runAsGroup: 10000, seccompProfile: { type: RuntimeDefault } }
      containers:
        - name: init
          image: {{ $mysqlImage }}
          securityContext: { allowPrivilegeEscalation: false, capabilities: { drop: [ALL] } }
          env:
            - { name: MYSQL_PWD, valueFrom: { secretKeyRef: { name: moco-{{ $name }}, key: ADMIN_PASSWORD } } }
            - { name: APP_PASSWORD, valueFrom: { secretKeyRef: { name: {{ $name }}-app, key: password } } }
          command:
            - sh
            - -ec
            - >-
              mysql -h {{ $host }} -u moco-admin -e "CREATE DATABASE IF NOT EXISTS \`{{ $db }}\`;
              CREATE USER IF NOT EXISTS '{{ $db }}'@'%' IDENTIFIED BY '${APP_PASSWORD}';
              ALTER USER '{{ $db }}'@'%' IDENTIFIED BY '${APP_PASSWORD}';
              GRANT ALL ON \`{{ $db }}\`.* TO '{{ $db }}'@'%';"
{{- end }}
