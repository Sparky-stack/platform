{{- /* aws-rds: RDS manages the master password in Secrets Manager; ESO copies it once the endpoint is known. */}}
{{- if and (eq $backend "aws-rds") (and $host $rdsSecretArn) }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-mysql
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
spec:
  refreshInterval: 1h                     # RDS rotates the master secret
  secretStoreRef: { kind: ClusterSecretStore, name: default }
  target:
    name: {{ $name }}-mysql
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "3306"
        database: {{ $db }}
        username: '{{ $o }} .username {{ $c }}'
        password: '{{ $o }} .password {{ $c }}'
        uri: 'mysql://{{ $o }} .username | urlquery {{ $c }}:{{ $o }} .password | urlquery {{ $c }}@{{ $host }}:3306/{{ $db }}?tls=true'
  data:
    - { secretKey: username, remoteRef: { key: {{ $rdsSecretArn }}, property: username } }
    - { secretKey: password, remoteRef: { key: {{ $rdsSecretArn }}, property: password } }
{{- end }}
