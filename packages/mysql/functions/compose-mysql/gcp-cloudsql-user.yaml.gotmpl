{{- /* The app user, password read by the provider from the connection Secret (exists once the host is known). */}}
{{- if and (eq $backend "gcp-cloudsql") $host }}
---
apiVersion: sql.gcp.m.upbound.io/v1beta1
kind: User
metadata:
  name: {{ $name }}-user
  annotations:
    {{ setResourceNameAnnotation "user" }}
    crossplane.io/external-name: {{ $db }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    project: {{ $facts.project }}
    instanceRef: { name: {{ $name }} }
    passwordSecretRef: { name: {{ $name }}-app, key: password }
{{- end }}
