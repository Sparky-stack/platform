{{- /* The <name>-app Secret (keys as the PostgreSQL API: host, port, dbname, username, password, uri), fixed keys. Generated once (CreatedOnce): deleting it rotates the password. Waits for the host. */}}
{{- if and (has $backend (list "moco" "gcp-cloudsql" "azure-flexible")) $host }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "3306"
        dbname: {{ $db }}
        username: {{ $db }}
        password: '{{ $o }} .password {{ $c }}'
        uri: 'mysql://{{ $db }}:{{ $o }} .password {{ $c }}@{{ $host }}:3306/{{ $db }}{{ $tlsQuery }}'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-mysql-password
{{- end }}
