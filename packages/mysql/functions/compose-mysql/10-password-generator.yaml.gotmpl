{{- /* moco / gcp / azure: the password is generated in-cluster by ESO; Crossplane's pipeline never sees it. */}}
{{- if has $backend (list "moco" "gcp-cloudsql" "azure-flexible") }}
---
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{ $name }}-mysql-password
  annotations:
    {{ setResourceNameAnnotation "password-generator" }}
    gotemplating.fn.crossplane.io/ready: "True"
spec: { length: 32, digits: 8, symbols: 0, noUpper: false, allowRepeat: true }
{{- end }}
