{{- /* The <name>-kafka-topic Secret, fixed keys, generated once (deleting it rotates the password). */}}
{{- if eq $backend "strimzi" }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-kafka-topic
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-kafka-topic
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        bootstrapServers: {{ $bootstrap }}
        topic: {{ $topic }}
        securityProtocol: {{ $protocol }}
        saslMechanism: {{ $mechanism }}
        username: {{ $name }}-kafka-topic
        password: '{{ $o }} .password {{ $c }}'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-kafka-topic-password
{{- end }}
