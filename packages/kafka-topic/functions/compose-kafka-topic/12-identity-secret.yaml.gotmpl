{{- /* Cloud backends: same keys, no password - the app's workload identity authenticates (SASL OAUTHBEARER / AWS_MSK_IAM). */}}
{{- if has $backend (list "aws-msk" "gcp-managedkafka" "azure-eventhubs") }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ $name }}-kafka-topic
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
    gotemplating.fn.crossplane.io/ready: "True"
type: Opaque
stringData:
  bootstrapServers: {{ $bootstrap }}
  topic: {{ $topic }}
  securityProtocol: {{ $protocol }}
  saslMechanism: {{ $mechanism }}
  username: ""
  password: ""
{{- end }}
