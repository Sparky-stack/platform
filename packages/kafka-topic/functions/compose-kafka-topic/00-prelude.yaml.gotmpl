{{- /* Prelude of compose-kafka-topic (files render in name order into one template, so these variables reach every
file): the cluster's facts, the backend check, the developer's spec with the XRD defaults as fallbacks, and the values
derived from them. Object files only read these. */}}
{{- $xr := getCompositeResource . }}
{{- $facts := index (.context | default dict) "apiextensions.crossplane.io/environment" | default dict }}
{{- $backend := dig "backend" "" $facts }}
{{- if not (has $backend (list "strimzi" "aws-msk" "gcp-managedkafka" "azure-eventhubs")) }}
{{- fail (printf "kafka-topic: unknown backend %q in EnvironmentConfig platform-kafka-topic (strimzi | aws-msk | gcp-managedkafka | azure-eventhubs)" $backend) }}
{{- end }}
{{- $spec := $xr.spec | default dict }}
{{- $name := $xr.metadata.name }}
{{- $ns := $xr.metadata.namespace }}
{{- $observed := .observed.resources | default dict }}
{{- $size := dig "size" "S" $spec }}
{{- $ha := eq (toString (dig "highAvailability" false $spec)) "true" }}
{{- /* Cloud identifier: unique per cluster/namespace/name, starts with a letter, no double hyphens. */}}
{{- $base := regexReplaceAll "-+" (printf "%s-%s" $ns $name | replace "." "-") "-" | trunc 30 | trimSuffix "-" }}
{{- $hash := sha1sum (printf "%s/%s/%s" $facts.cluster $ns $name) }}
{{- $id := printf "kt-%s-%s" $base ($hash | trunc 8) }}
{{- /* Retain: Crossplane never deletes the cloud resource (v2 managed resources have no deletionPolicy). */}}
{{- $retain := eq (dig "deletionPolicy" "Retain" $spec) "Retain" }}
{{- $mp := list "*" }}
{{- if $retain }}{{ $mp = list "Observe" "Create" "Update" "LateInitialize" }}{{ end }}
{{- $pc := dict "kind" "ClusterProviderConfig" "name" "default" }}
{{- /* ESO template delimiters, emitted literally into ExternalSecret templates. */}}
{{- $o := "{{" }}
{{- $c := "}}" }}
{{- $topic := printf "%s.%s" $ns $name }}
{{- $partitions := dig "partitions" 3 $spec | int }}
{{- $retentionMs := mul (dig "retentionHours" 168 $spec | int) 3600000 }}
{{- $cleanup := dig "cleanupPolicy" "delete" $spec }}
{{- /* How clients reach the cluster's Kafka (facts) and authenticate: SCRAM user locally, the workload identity in
cloud (MSK IAM, Google OAUTHBEARER, Entra OAUTHBEARER on the Event Hubs Kafka endpoint). */}}
{{- $bootstrap := dig "bootstrapServers" "" $facts }}
{{- $mechanism := get (dict "strimzi" "SCRAM-SHA-512" "aws-msk" "AWS_MSK_IAM" "gcp-managedkafka" "OAUTHBEARER" "azure-eventhubs" "OAUTHBEARER") $backend }}
{{- $protocol := ternary "SASL_PLAINTEXT" "SASL_SSL" (eq $backend "strimzi") }}
{{- if eq $backend "azure-eventhubs" }}{{ $bootstrap = printf "%s.servicebus.windows.net:9093" $facts.eventhubNamespace }}{{ $topic = $name }}{{ end }}
