{{- /* strimzi: a KafkaTopic for the cluster's Kafka (facts.kafkaCluster). Strimzi's Topic / User Operator each watch ONE namespace: the XR's namespace needs its own (standalone) operators or the Kafka cluster - VERIFY, the main open design point. */}}
{{- if eq $backend "strimzi" }}
---
apiVersion: kafka.strimzi.io/v1
kind: KafkaTopic
metadata:
  name: {{ $name }}
  labels: { strimzi.io/cluster: {{ $facts.kafkaCluster }} }
  annotations:
    {{ setResourceNameAnnotation "topic" }}
spec:
  topicName: {{ $topic }}
  partitions: {{ $partitions }}
  replicas: {{ dig "replicationFactor" 1 $facts | int }}
  config:
    retention.ms: {{ $retentionMs }}
    cleanup.policy: {{ $cleanup }}
{{- end }}
