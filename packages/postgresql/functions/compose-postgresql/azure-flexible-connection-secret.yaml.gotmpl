{{- /* azure-flexible: ExternalSecret <name>-app (FQDN is deterministic, exists before the server). */}}
{{- if eq $backend "azure-flexible" }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: connection-secret
spec:
  refreshPolicy: CreatedOnce          # deleting the Secret rotates the password (the provider applies the new one)
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $fqdn }}
        port: "5432"
        dbname: {{ $db }}
        username: {{ $db }}
        password: '{{ $o }} .password {{ $c }}'
        uri: 'postgresql://{{ $db }}:{{ $o }} .password {{ $c }}@{{ $fqdn }}:5432/{{ $db }}?sslmode=require'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-password
{{- end }}
