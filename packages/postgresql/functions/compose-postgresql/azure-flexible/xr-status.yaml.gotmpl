{{- /* azure-flexible: the XR status. */}}
{{- if eq $backend "azure-flexible" }}
---
apiVersion: platform.koorikla.io/v1alpha1
kind: PostgreSQL
status:
  backend: azure-flexible
  backup: {{ ternary "enabled" "disabled" (eq (toString $backup) "true") }}
  endpoint: {{ $host }}
  port: 5432
  secretName: {{ $name }}-app
{{- end }}
