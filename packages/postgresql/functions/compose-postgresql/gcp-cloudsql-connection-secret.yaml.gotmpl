{{- /* gcp-cloudsql: ExternalSecret <name>-app, once the instance reports its private IP. */}}
{{- if and (eq $backend "gcp-cloudsql") $host }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: connection-secret
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "5432"
        dbname: {{ $db }}
        username: {{ $db }}
        password: '{{ $o }} .password {{ $c }}'
        uri: 'postgresql://{{ $db }}:{{ $o }} .password {{ $c }}@{{ $host }}:5432/{{ $db }}?sslmode=require'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-password
{{- end }}
