{{- /* cnpg: PodMonitor, when the cluster runs Prometheus (fact podMonitor). */}}
{{- if and (eq $backend "cnpg") $facts.podMonitor }}
---
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pod-monitor
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  selector:
    matchLabels:
      cnpg.io/cluster: {{ $name }}
  podMetricsEndpoints:
    - port: metrics
{{- end }}
