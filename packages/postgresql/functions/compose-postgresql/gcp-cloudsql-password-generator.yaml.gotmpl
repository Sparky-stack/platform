{{- /* gcp-cloudsql: ESO Password generator for the owner role. */}}
{{- if eq $backend "gcp-cloudsql" }}
---
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{ $name }}-password
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: password-generator
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  length: 32
  digits: 8
  symbols: 0                          # URI-safe without escaping
  noUpper: false
  allowRepeat: true
{{- /* Connection Secret once the private IP is known; generated once (CreatedOnce): deleting the Secret rotates the
password (a new one is generated and the provider applies it to the user). */}}
{{- end }}
