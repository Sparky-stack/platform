{{- /* aws-rds: ExternalSecret copying the RDS-managed master secret into <name>-app, once RDS reports endpoint + ARN. */}}
{{- if and (eq $backend "aws-rds") (and $host $secretArn) }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: connection-secret
spec:
  refreshInterval: 1h                   # RDS rotates the master secret (default every 7 days)
  secretStoreRef:
    kind: ClusterSecretStore
    name: default
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "5432"
        dbname: {{ $db }}
        username: '{{ $o }} .username {{ $c }}'
        password: '{{ $o }} .password {{ $c }}'
        uri: 'postgresql://{{ $o }} .username | urlquery {{ $c }}:{{ $o }} .password | urlquery {{ $c }}@{{ $host }}:5432/{{ $db }}?sslmode=require'
  data:
    - secretKey: username
      remoteRef: { key: {{ $secretArn }}, property: username }
    - secretKey: password
      remoteRef: { key: {{ $secretArn }}, property: password }
{{- end }}
