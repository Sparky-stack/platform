{{- /* Locals of the aws-rds/ files (evaluated on every backend: keep them side-effect free, never `fail` here).
Only the object files, guarded by `if eq $backend "aws-rds"`, render. */}}
{{- /* aws-rds: RDS for PostgreSQL instance (Multi-AZ when highAvailability) or Aurora PostgreSQL (spec.engine aurora),
in the cluster's VPC, reachable only from the cluster's node security group, storage encrypted with a per-database KMS
key, IAM database authentication on. The master password is generated and rotated by RDS in Secrets Manager
(manageMasterUserPassword) - it never passes through Crossplane; ESO copies it into the connection Secret. */}}
{{- $aurora := eq (dig "engine" "postgres" $spec) "aurora" }}
{{- $classes := dict "S" "db.t4g.medium" "M" "db.m7g.large" "L" "db.r7g.xlarge" }}
{{- if $aurora }}{{ $classes = dict "S" "db.t4g.medium" "M" "db.r7g.large" "L" "db.r7g.xlarge" }}{{ end }}
{{- $class := get $classes $size }}
{{- $pc := dict "kind" "ClusterProviderConfig" "name" "default" }}
{{- $tags := dict "platform.koorikla.io/cluster" $facts.cluster "platform.koorikla.io/namespace" $ns "platform.koorikla.io/postgresql" $name }}
{{- $retentionPeriod := 0 }}
{{- if $backup }}{{ $retentionPeriod = $retention }}{{ else if $aurora }}{{ $retentionPeriod = 1 }}{{ end }}
{{- $endpointKey := "instance" }}
{{- if $aurora }}{{ $endpointKey = "cluster" }}{{ end }}
{{- /* Connection Secret, once RDS reports the endpoint and the Secrets Manager ARN of the managed master secret. */}}
{{- $at := dig $endpointKey "resource" "status" "atProvider" dict $observed }}
{{- $host := ternary (dig "endpoint" "" $at) (dig "address" "" $at) $aurora }}
{{- $secretArn := "" }}
{{- with (dig "masterUserSecret" list $at) }}{{ $secretArn = dig "secretArn" "" (first .) }}{{ end }}
