{{- /* Locals of the cnpg/ files (evaluated on every backend: keep them side-effect free, never `fail` here).
Only the object files, guarded by `if eq $backend "cnpg"`, render. */}}
{{- /* cnpg: a CloudNativePG Cluster in the XR's namespace (addon cloudnative-pg), image from the ClusterImageCatalog by
major version, 3 instances (primary + 2 streaming replicas, automated failover) when highAvailability. The operator
generates the password and writes the connection Secret <name>-app itself; it never leaves the namespace. Backups:
Barman Cloud plugin (ObjectStore + ScheduledBackup) when asked for and the cluster has an object store. */}}
{{- $sizes := dict
  "S" (dict "cpu" "100m" "memory" "256Mi" "limit" "512Mi")
  "M" (dict "cpu" "500m" "memory" "1Gi" "limit" "2Gi")
  "L" (dict "cpu" "2" "memory" "4Gi" "limit" "8Gi") }}
{{- $res := get $sizes $size }}
{{- $dest := dig "backup" "destinationPath" "" $facts }}
{{- $backupOn := and $backup $dest }}
