{{- /* The <name>-valkey Secret (username, password), generated once: deleting it rotates the password. */}}
{{- if has $backend (list "valkey-operator" "aws-elasticache") }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-valkey
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-valkey
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        username: {{ ternary "app" "default" (eq $backend "valkey-operator") }}
        password: '{{ $o }} .password {{ $c }}'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-valkey-password
{{- end }}
