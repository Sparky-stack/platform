{{- /* Identity backends (IAM / Entra ID): same keys, empty password - clients present a workload identity token. */}}
{{- if has $backend (list "gcp-memorystore" "azure-cache") }}
---
apiVersion: v1
kind: Secret
metadata:
  name: {{ $name }}-valkey
  annotations:
    {{ setResourceNameAnnotation "connection-secret" }}
    gotemplating.fn.crossplane.io/ready: "True"
type: Opaque
stringData:
  username: {{ ternary "default" "" (eq $backend "gcp-memorystore") }}
  password: ""
{{- end }}
