{{- /* Password backends: ESO generates the password in-cluster; Crossplane's pipeline never sees it. */}}
{{- if has $backend (list "valkey-operator" "aws-elasticache") }}
---
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{ $name }}-valkey-password
  annotations:
    {{ setResourceNameAnnotation "password-generator" }}
    gotemplating.fn.crossplane.io/ready: "True"
spec: { length: 32, digits: 8, symbols: 0, noUpper: false, allowRepeat: true }
{{- end }}
