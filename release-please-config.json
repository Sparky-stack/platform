{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bump-minor-pre-major": true,
  "separate-pull-requests": false,
  "group-pull-request-title-pattern": "chore: release ${branch}",
  "packages": {
    ".": {
      "component": "platform",
      "include-component-in-tag": false,
      "exclude-paths": [
        "ci",
        "packages/postgresql",
        "packages/mysql",
        "packages/valkey",
        "packages/bucket",
        "packages/kafka-topic"
      ],
      "changelog-path": "CHANGELOG.md"
    },
    "ci": {
      "component": "ci",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/postgresql": {
      "component": "postgresql",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/mysql": {
      "component": "mysql",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/valkey": {
      "component": "valkey",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/bucket": {
      "component": "bucket",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    },
    "packages/kafka-topic": {
      "component": "kafka-topic",
      "include-component-in-tag": true,
      "tag-separator": "-",
      "changelog-path": "CHANGELOG.md"
    }
  }
}
