# Multicluster profile (docs/dev-environment.md "Local profiles"): disabled by default to save ~3.4 GiB host RAM.
# Switch on: rename this file to prod1.yaml and remove `production` from dev1.yaml's environments (the Environment's
# dataPlaneRef is immutable: production must be on exactly one enabled cluster; hack/tests/test_local_profiles.sh).
# On a running stack the move takes two merges (pipeline): docs/dev-environment.md "Local profiles".
name: prod1
provider: docker
region: local
environment: production
cni: flannel                # exercise the flannel path locally; dev1 runs the default (cilium)
kubernetesVersion: v1.35.10+k3s1
controlPlane:
  replicas: 1
workers:
  - name: md-0
    replicas: 0
openchoreo:
  dataPlane:
    enabled: true
    gatewayHost: prod1.apps.localhost
    environments: [production]
mesh:
  group: local              # east-west connectivity with the other members (docs/multicluster.md)
addonsRevision: HEAD
addons: {}
