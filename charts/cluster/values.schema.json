{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "charts/cluster values",
  "description": "Types, enums and per-provider required keys. Cross-field checks: templates/validate.yaml.",
  "type": "object",
  "properties": {
    "scope": {
      "type": "string",
      "description": "fleet: providers + ClusterClasses on mgmt (one per installation); cluster: one cluster file.",
      "enum": [
        "cluster",
        "fleet"
      ]
    },
    "name": {
      "type": "string",
      "description": "Cluster name (scope cluster); empty in scope fleet."
    },
    "provider": {
      "type": "string",
      "description": "Infrastructure: ClusterClass k3s-<provider>, gke-managed for gcp-gke, byo = existing cluster.",
      "enum": [
        "docker",
        "aws",
        "hetzner",
        "gcp-gke",
        "byo"
      ]
    },
    "region": {
      "type": "string",
      "description": "Provider region (label platform.koorikla.io/region)."
    },
    "environment": {
      "type": "string",
      "description": "Environment class (docs/conventions.md).",
      "enum": [
        "development",
        "staging",
        "production"
      ]
    },
    "kubernetesVersion": {
      "type": "string",
      "description": "k3s release (k3s providers) or GKE version (gcp-gke); empty for byo."
    },
    "cni": {
      "type": "string",
      "description": "Pod network, fixed at birth (docs/networking.md)."
    },
    "controlPlane": {
      "type": "object",
      "description": "Control plane size (k3s providers only).",
      "properties": {
        "replicas": {
          "description": "k3s servers = embedded etcd voters: odd (1, 3, 5); unset = 1.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 1,
              "not": {
                "multipleOf": 2
              }
            }
          ]
        },
        "machineType": {
          "type": "string",
          "description": "Provider instance type (aws t3.large, hetzner cpx31)."
        }
      }
    },
    "workers": {
      "type": "array",
      "description": "MachineDeployments (GKE: node pools).",
      "items": {
        "type": "object",
        "description": "One worker pool.",
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pool name, unique per cluster.",
            "minLength": 1
          },
          "replicas": {
            "type": "integer",
            "description": "Node count.",
            "minimum": 0
          },
          "machineType": {
            "type": "string",
            "description": "Provider instance type."
          },
          "failureDomain": {
            "type": "string",
            "description": "Zone / failure domain."
          }
        }
      }
    },
    "providerSpec": {
      "type": "object",
      "description": "Extra ClusterClass variables, passed as-is (docs/providers.md)."
    },
    "addons": {
      "type": "object",
      "description": "<addon>: true|false -> label addons.platform.koorikla.io/<addon>.",
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "mesh": {
      "type": "object",
      "description": "Istio ambient multicluster (docs/multicluster.md).",
      "properties": {
        "group": {
          "type": "string",
          "description": "Mesh group this cluster joins; empty = none.",
          "pattern": "^([a-z]([-a-z0-9]{0,30}[a-z0-9])?)?$"
        },
        "groups": {
          "type": "array",
          "description": "installation.yaml: the installation's mesh groups.",
          "items": {
            "type": "string"
          }
        },
        "ca": {
          "type": "object",
          "description": "installation.yaml: {host, port} where members reach OpenBao."
        }
      }
    },
    "leaderElection": {
      "type": "object",
      "description": "Lease flags of every CAPI manager with leaseFlags.",
      "required": [
        "leaseDuration",
        "renewDeadline",
        "retryPeriod"
      ],
      "properties": {
        "leaseDuration": {
          "type": "string",
          "description": "--leader-elect-lease-duration.",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "renewDeadline": {
          "type": "string",
          "description": "--leader-elect-renew-deadline.",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "retryPeriod": {
          "type": "string",
          "description": "--leader-elect-retry-period.",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|ms|s|m|h))+$"
        },
        "resourceName": {
          "type": [
            "string",
            "null"
          ],
          "description": "Must stay empty: the operator would pass --leader-election-id, which CAPI managers lack.",
          "maxLength": 0
        },
        "resourceNamespace": {
          "type": [
            "string",
            "null"
          ],
          "description": "Must stay empty (see resourceName).",
          "maxLength": 0
        }
      }
    },
    "capi": {
      "type": "object",
      "description": "installation.yaml: infrastructure providers and their credentials.",
      "properties": {
        "providers": {
          "type": "object",
          "description": "Infrastructure providers installed on mgmt.",
          "properties": {
            "docker": {
              "type": "boolean",
              "description": "Install CAPD."
            },
            "aws": {
              "type": "boolean",
              "description": "Install CAPA."
            },
            "hetzner": {
              "type": "boolean",
              "description": "Install CAPH."
            },
            "gcp": {
              "type": "boolean",
              "description": "Install CAPG."
            }
          }
        },
        "gcp": {
          "type": "object",
          "description": "CAPG Workload Identity Federation (docs/providers.md \"GKE\").",
          "properties": {
            "workloadIdentityProvider": {
              "type": "string",
              "description": "projects/<number>/locations/global/workloadIdentityPools/<pool>/providers/<provider>.",
              "pattern": "^(projects/[0-9]+/locations/global/workloadIdentityPools/[-a-z0-9]+/providers/[-a-z0-9]+)?$"
            },
            "serviceAccount": {
              "type": "string",
              "description": "<name>@<project>.iam.gserviceaccount.com to impersonate.",
              "pattern": "^([-a-z0-9]+@[-a-z0-9]+\\.iam\\.gserviceaccount\\.com)?$"
            }
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "description": "Injected by the addons ApplicationSet (--set-string) in scope fleet; unused here."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "cluster"
          }
        }
      },
      "then": {
        "$ref": "#/$defs/clusterFile"
      }
    }
  ],
  "$defs": {
    "clusterFile": {
      "description": "Rules for a cluster file (scope cluster): installations/<inst>/clusters/<name>.yaml.",
      "required": [
        "name",
        "provider",
        "environment",
        "cni"
      ],
      "properties": {
        "name": {
          "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$",
          "description": "DNS label, max 32 chars: Argo cluster, ClusterDataPlane and planeID name."
        }
      },
      "allOf": [
        {
          "description": "k3s providers: k3s release and a CNI the ClusterClass can install.",
          "if": {
            "properties": {
              "provider": {
                "enum": [
                  "docker",
                  "aws",
                  "hetzner"
                ]
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "kubernetesVersion"
            ],
            "properties": {
              "kubernetesVersion": {
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+\\+k3s[0-9]+$",
                "description": "k3s release vX.Y.Z+k3sN."
              },
              "cni": {
                "enum": [
                  "cilium",
                  "flannel"
                ],
                "description": "k3s clusters: the CNI the ClusterClass installs at birth."
              }
            }
          }
        },
        {
          "description": "cloud providers need a region.",
          "if": {
            "properties": {
              "provider": {
                "enum": [
                  "aws",
                  "hetzner",
                  "gcp-gke"
                ]
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "region"
            ],
            "properties": {
              "region": {
                "minLength": 1
              }
            }
          }
        },
        {
          "description": "gcp-gke: GKE version, cni gke, >= 1 node pool, GCP project.",
          "if": {
            "properties": {
              "provider": {
                "const": "gcp-gke"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "required": [
              "kubernetesVersion",
              "workers",
              "providerSpec"
            ],
            "properties": {
              "kubernetesVersion": {
                "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$",
                "description": "GKE version vX.Y.Z."
              },
              "cni": {
                "const": "gke",
                "description": "CAPG v1.13.1 cannot enable Dataplane V2 (Cilium): GKE's VPC-native networking."
              },
              "workers": {
                "minItems": 1,
                "description": "At least one GKE node pool."
              },
              "providerSpec": {
                "required": [
                  "project"
                ],
                "properties": {
                  "project": {
                    "type": "string",
                    "description": "GCP project id.",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        {
          "description": "byo: cni is a label naming the existing cluster's CNI.",
          "if": {
            "properties": {
              "provider": {
                "const": "byo"
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "cni": {
                "pattern": "^[a-z]([-a-z0-9]{0,30}[a-z0-9])?$",
                "description": "byo: names the CNI the cluster already runs (cilium, calico, ...)."
              }
            }
          }
        }
      ]
    }
  }
}
