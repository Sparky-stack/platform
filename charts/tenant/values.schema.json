{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "tenant chart values",
  "description": "installation.yaml + installations/<inst>/tenants/<project>.yaml. Top level open: installation.yaml carries keys for other charts.",
  "type": "object",
  "properties": {
    "project": {
      "type": "string",
      "description": "OpenChoreo Project = tenant name (DNS-1123 label, <= 50 chars); required, \"\" only in the chart defaults.",
      "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?)?$",
      "maxLength": 50
    },
    "description": {
      "type": "string",
      "description": "Project description."
    },
    "apps": {
      "type": "array",
      "items": {
        "type": "object",
        "description": "One tenant app (an OpenChoreo Component repo).",
        "additionalProperties": false,
        "required": [
          "name",
          "repoURL"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Component name (== the app repo's Component), a DNS-1123 label; unique.",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "repoURL": {
            "type": "string",
            "description": "App repository (GitHub https URLs also get PR previews).",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "description": "Path of the OpenChoreo objects in the app repo (default defaults.path)."
          },
          "revision": {
            "type": "string",
            "description": "Git revision (default defaults.revision)."
          },
          "promotionGates": {
            "type": [
              "boolean",
              "string"
            ],
            "enum": [
              true,
              false,
              "true",
              "false"
            ],
            "description": "false: no gated-environment Applications for this app."
          },
          "description": {
            "type": "string",
            "description": "Free text (documentation only)."
          }
        }
      },
      "description": "The tenant's apps."
    },
    "demoSecrets": {
      "type": "array",
      "description": "Demo seeds key/property written into the tenant's OpenBao mount.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "property"
        ],
        "properties": {
          "key": {
            "type": "string",
            "description": "Store key; a lowercase DNS label because it names PushSecret <project>-seed-<key>.",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          },
          "property": {
            "type": "string",
            "description": "Property of the key.",
            "pattern": "^[A-Za-z0-9._-]+$"
          }
        }
      }
    },
    "developerGroups": {
      "type": "array",
      "description": "Groups (JWT claim groups) with OpenChoreo role developer in this project only; empty = [<project>-developers].",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "installation": {
      "type": "object",
      "description": "From installation.yaml.",
      "properties": {
        "repoURL": {
          "type": "string",
          "description": "Platform repo: source of the preview Applications.",
          "minLength": 1
        }
      },
      "required": [
        "repoURL"
      ]
    },
    "previews": {
      "type": "object",
      "description": "PR preview environments (docs/preview-environments.md).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Render the previews ApplicationSet (also needs secrets.githubGateApp.enabled)."
        },
        "dataPlane": {
          "type": "string",
          "description": "ClusterDataPlane of the previews.",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "requeueAfterSeconds": {
          "type": "integer",
          "minimum": 1,
          "description": "PR generator poll interval."
        },
        "expiredLabel": {
          "type": "string",
          "description": "PR label that expires a preview: letters, digits, space, . _ - (\"\" = preview-expired).",
          "pattern": "^([A-Za-z0-9][A-Za-z0-9 ._-]*)?$"
        },
        "waitingLabel": {
          "type": "string",
          "description": "PR label of a preview held by the per-tenant cap: letters, digits, space, . _ -.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
        },
        "skipBots": {
          "type": "boolean",
          "description": "PRs by [bot] authors render no preview unless labelled botLabel."
        },
        "botLabel": {
          "type": "string",
          "description": "PR label that gives a bot PR a preview: letters, digits, space, . _ -.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._-]*$"
        }
      },
      "required": [
        "dataPlane"
      ]
    },
    "promotion": {
      "type": "object",
      "description": "Promotion gates and freeze windows.",
      "properties": {
        "gatedEnvironments": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "Environment.",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "description": "Environments only the promotion gate may bind."
        },
        "freezeWindows": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "Weekly freeze window -> Argo CD deny sync window.",
            "required": [
              "start",
              "end"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Window name."
              },
              "start": {
                "type": "string",
                "description": "Start, e.g. \"Fri 16:00\" (weekday HH:MM).",
                "pattern": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) ([01]?[0-9]|2[0-3]):([0-5][0-9])$"
              },
              "end": {
                "type": "string",
                "description": "End, e.g. \"Mon 08:00\" (wraps around the week; != start, templates/_helpers.tpl).",
                "pattern": "^(Mon|Tue|Wed|Thu|Fri|Sat|Sun) ([01]?[0-9]|2[0-3]):([0-5][0-9])$"
              },
              "timeZone": {
                "type": "string",
                "description": "IANA time zone of start/end."
              },
              "environments": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "Environment.",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                },
                "description": "Environments the window freezes."
              }
            }
          },
          "description": "Weekly freeze windows."
        }
      }
    },
    "sourceIntegrity": {
      "type": "object",
      "description": "Git commit signature verification (tenant AppProject).",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Enable sourceIntegrity on the tenant AppProject."
        },
        "mode": {
          "type": "string",
          "description": "none | head | strict.",
          "enum": [
            "none",
            "head",
            "strict"
          ]
        }
      }
    }
  },
  "required": [
    "installation",
    "previews"
  ]
}
