{{- /*
"true" when the Argo Workflows CRDs exist on this cluster (the OpenChoreo workflow plane, addon
openchoreo-workflow-plane): workflowPlane auto asks Capabilities (Argo CD passes the destination cluster's API
versions, kinds included, to helm template) unless installation.yaml turns the plane off
(openchoreo.workflowPlane.enabled: false); "true" / "false" force it. Without them the WorkflowTemplate would fail
to apply (SkipDryRunOnMissingResource only skips the dry run) and the Sensors would create Workflows nobody runs.
*/ -}}
{{- define "ae.workflowPlane" -}}
{{- $m := toString .Values.workflowPlane -}}
{{- if eq $m "auto" -}}
{{- $wp := dig "workflowPlane" "enabled" true (.Values.openchoreo | default dict) -}}
{{- and $wp (.Capabilities.APIVersions.Has "argoproj.io/v1alpha1/WorkflowTemplate") -}}
{{- else -}}
{{- $m -}}{{- /* "true" / "false"; anything else fails in validate.yaml */ -}}
{{- end -}}
{{- end }}

{{- /*
Clusters that may escalate Falco events (falco.clusters: every platform cluster, generated by the addon ApplicationSet
from the Argo CD cluster secrets, catalog fleetParameters), as a sorted, unique JSON list. validate.yaml checks they
are DNS-1123 labels: they become endpoint paths, Secret keys and Sensor dependency names.
*/ -}}
{{- define "ae.falcoClusters" -}}
{{- $out := list -}}
{{- range (.Values.falco.clusters | default list) }}{{ $out = append $out (toString .) }}{{ end -}}
{{- $out | uniq | sortAlpha | toJson -}}
{{- end }}

{{- /*
Per-cluster webhook token, as an ESO (engine v2) template expression over the platform store's `falco-webhook` token:
  sha256("<cluster>:<token>")  (hex)
The same expression, for the same cluster name, renders the sender's header in charts/cluster (CRS payload of a
workload cluster) and addon falco (mgmt); hack/tests/test_falco_tokens.sh keeps the three identical. The shared token
never leaves mgmt's store; a cluster's token proves nothing about any other cluster (no preimage).
*/ -}}
{{- define "ae.falcoToken" -}}
{{- printf "{{ printf \"%%s:%%s\" %s .token | sha256sum }}" (quote .) -}}
{{- end }}

{{- /*
Pod template of every EventSource / Sensor (one pod each): Pod Security restricted, since the namespace is reachable
from outside the cluster. Literal YAML on purpose (toYaml of a dict would sort the keys). Argument: ServiceAccount name.
*/ -}}
{{- define "ae.eventPod" -}}
serviceAccountName: {{ .sa }}
securityContext:
  runAsGroup: 65532
  runAsNonRoot: true
  runAsUser: 65532
  seccompProfile:
    type: RuntimeDefault
container:
  resources: {{- toYaml .root.Values.podResources | nindent 4 }}
  securityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - ALL
    readOnlyRootFilesystem: true
{{- end }}
