{{- /*
"true" when Argo Workflows (the OpenChoreo workflow plane) runs falco-response and the gates: `auto` asks Capabilities
(Argo CD passes the destination's API versions) unless installation.yaml turns the plane off; "true" / "false" force it.
*/ -}}
{{- define "ae.workflowPlane" -}}
{{- $m := toString .Values.workflowPlane -}}
{{- if eq $m "auto" -}}
{{- and .Values.openchoreo.workflowPlane.enabled (.Capabilities.APIVersions.Has "argoproj.io/v1alpha1/WorkflowTemplate") -}}
{{- else -}}
{{- $m -}}
{{- end -}}
{{- end }}

{{- /*
"true" when the auto-build webhook renders: autoBuild `webhook`, the workflow plane, and the platform GitHub App (its
Workflows need the App's tokens; addon openchoreo-platform renders WorkflowTemplate auto-build only with it).
*/ -}}
{{- define "ae.autoBuildWebhook" -}}
{{- $gate := dig "githubGateApp" "enabled" false (.Values.secrets | default dict) -}}
{{- and (eq (toString .Values.openchoreo.workflowPlane.autoBuild) "webhook") (eq (include "ae.workflowPlane" .) "true") $gate -}}
{{- end }}

{{- /*
falco.clusters (generated by the addon ApplicationSet, catalog fleetParameters) as a sorted, unique JSON list.
*/ -}}
{{- define "ae.falcoClusters" -}}
{{- $out := list -}}
{{- range (.Values.falco.clusters | default list) }}{{ $out = append $out (toString .) }}{{ end -}}
{{- $out | uniq | sortAlpha | toJson -}}
{{- end }}

{{- /*
Per-cluster webhook token, as an ESO (engine v2) template expression over the platform store's `falco-webhook` token:
  sha256("<cluster>:<token>")  (hex)
The same expression, for the same cluster name, renders the sender's header in charts/cluster (CRS payload of a
workload cluster) and addon falco (mgmt); hack/tests/test_falco_tokens.sh keeps the three identical. The shared token
never leaves mgmt's store; a cluster's token proves nothing about any other cluster (no preimage).
*/ -}}
{{- define "ae.falcoToken" -}}
{{- printf "{{ printf \"%%s:%%s\" %s .token | sha256sum }}" (quote .) -}}
{{- end }}

{{- /*
Pod template of every EventSource / Sensor (one pod each): Pod Security restricted, since the namespace is reachable
from outside the cluster. Literal YAML on purpose (toYaml of a dict would sort the keys). Argument: ServiceAccount name.
*/ -}}
{{- define "ae.eventPod" -}}
serviceAccountName: {{ .sa }}
securityContext:
  runAsGroup: 65532
  runAsNonRoot: true
  runAsUser: 65532
  seccompProfile:
    type: RuntimeDefault
container:
  resources: {{- toYaml .root.Values.podResources | nindent 4 }}
  securityContext:
    allowPrivilegeEscalation: false
    capabilities:
      drop:
        - ALL
    readOnlyRootFilesystem: true
{{- end }}

{{- /* Shared container tail (resources, restricted securityContext, /scripts mount) for falco-response steps. */ -}}
{{- define "ae.falcoScriptTrailer" -}}
resources: {{- toYaml . | nindent 2 }}
securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities: { drop: [ALL] }
volumeMounts:
  - { name: scripts, mountPath: /scripts, readOnly: true }
{{- end }}
