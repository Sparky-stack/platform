{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "reloader addon values",
  "type": "object",
  "properties": {
    "reloader": {
      "type": "object",
      "description": "Upstream stakater/reloader chart; only the platform invariants are constrained.",
      "properties": {
        "reloader": {
          "type": "object",
          "description": "Reloader settings.",
          "properties": {
            "watchGlobally": {
              "type": "boolean",
              "description": "true on workload clusters (cluster-wide watch, writes fenced by templates/rollout-guard.yaml); false = scoped Role per `namespaces` entry (mgmt)."
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "description": "Watched namespace.",
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "description": "Namespaces watched with a scoped Role each (non-empty when watchGlobally is false, empty otherwise: templates/validate.yaml)."
            },
            "reloadStrategy": {
              "const": "annotations",
              "description": "Annotation patch, not env vars: no containers[].env drift under Argo CD SSA."
            },
            "autoReloadAll": {
              "type": "boolean",
              "description": "Roll every workload mounting a changed object (needs resourceLabelSelector, templates/validate.yaml)."
            },
            "resourceLabelSelector": {
              "type": "string",
              "description": "Only ConfigMaps/Secrets with this label trigger reloads."
            },
            "readOnlyRootFileSystem": {
              "const": true,
              "description": "Pod Security restricted: read-only root filesystem."
            },
            "deployment": {
              "type": "object",
              "description": "Reloader Deployment.",
              "properties": {
                "securityContext": {
                  "type": "object",
                  "description": "Pod security context (Pod Security restricted).",
                  "properties": {
                    "runAsNonRoot": {
                      "const": true,
                      "description": "Pod Security restricted: non-root."
                    },
                    "seccompProfile": {
                      "type": "object",
                      "description": "Seccomp profile.",
                      "properties": {
                        "type": {
                          "const": "RuntimeDefault",
                          "description": "Pod Security restricted: RuntimeDefault."
                        }
                      },
                      "required": [
                        "type"
                      ]
                    }
                  },
                  "required": [
                    "runAsNonRoot",
                    "seccompProfile"
                  ]
                },
                "containerSecurityContext": {
                  "type": "object",
                  "description": "Container security context (Pod Security restricted).",
                  "properties": {
                    "allowPrivilegeEscalation": {
                      "const": false,
                      "description": "Pod Security restricted: no escalation."
                    },
                    "capabilities": {
                      "type": "object",
                      "description": "Linux capabilities.",
                      "properties": {
                        "drop": {
                          "type": "array",
                          "contains": {
                            "const": "ALL"
                          },
                          "description": "Must drop ALL."
                        }
                      },
                      "required": [
                        "drop"
                      ]
                    }
                  },
                  "required": [
                    "allowPrivilegeEscalation",
                    "capabilities"
                  ]
                }
              },
              "required": [
                "securityContext",
                "containerSecurityContext"
              ]
            }
          },
          "required": [
            "watchGlobally",
            "reloadStrategy",
            "readOnlyRootFileSystem",
            "deployment"
          ]
        }
      },
      "required": [
        "reloader"
      ]
    },
    "rolloutGuard": {
      "type": "object",
      "description": "Where Reloader may roll workloads besides tenant cells (templates/rollout-guard.yaml).",
      "properties": {
        "platformNamespaces": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
          },
          "description": "Platform namespaces with Reloader-annotated workloads."
        }
      },
      "required": [
        "platformNamespaces"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reloader"
  ]
}
