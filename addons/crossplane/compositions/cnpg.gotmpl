{{- /* Shared preamble (the same in every compositions/*.gotmpl): the XR's spec with the XRD defaults as fallbacks,
the cloud-side identifier and the deletion behaviour. $facts is prepended by templates/compositions.yaml. */}}
{{- $xr := .observed.composite.resource }}
{{- $spec := $xr.spec | default dict }}
{{- $name := $xr.metadata.name }}
{{- $ns := $xr.metadata.namespace }}
{{- $version := dig "version" "17" $spec | toString }}
{{- $size := dig "size" "S" $spec }}
{{- $storage := dig "storageGiB" 10 $spec | int }}
{{- $ha := dig "highAvailability" false $spec }}
{{- $backup := dig "backup" "enabled" false $spec }}
{{- $retention := dig "backup" "retentionDays" 7 $spec | int }}
{{- $db := dig "database" "app" $spec }}
{{- $retain := eq (dig "deletionPolicy" "Retain" $spec) "Retain" }}
{{- $observed := .observed.resources | default dict }}
{{- /* Cloud identifier: unique per cluster/namespace/name, starts with a letter, <= 52 chars, no double hyphens. */}}
{{- $base := regexReplaceAll "-+" (printf "%s-%s" $ns $name | replace "." "-") "-" | trunc 40 | trimSuffix "-" }}
{{- $id := printf "pg-%s-%s" $base (sha1sum (printf "%s/%s/%s" $facts.cluster $ns $name) | trunc 8) }}
{{- /* Retain: Crossplane never deletes the cloud resource (v2 managed resources have no deletionPolicy). */}}
{{- $mp := list "*" }}
{{- if $retain }}{{ $mp = list "Observe" "Create" "Update" "LateInitialize" }}{{ end }}
{{- /* ESO template delimiters, emitted literally into ExternalSecret templates. */}}
{{- $o := "{{" }}
{{- $c := "}}" }}

{{- /* cnpg: a CloudNativePG Cluster in the XR's namespace (addon cloudnative-pg), image from the ClusterImageCatalog by
major version, 3 instances (primary + 2 streaming replicas, automated failover) when highAvailability. The operator
generates the password and writes the connection Secret <name>-app itself; it never leaves the namespace. Backups:
Barman Cloud plugin (ObjectStore + ScheduledBackup) when asked for and the cluster has an object store. */}}
{{- $sizes := dict
  "S" (dict "cpu" "100m" "memory" "256Mi" "limit" "512Mi")
  "M" (dict "cpu" "500m" "memory" "1Gi" "limit" "2Gi")
  "L" (dict "cpu" "2" "memory" "4Gi" "limit" "8Gi") }}
{{- $res := get $sizes $size }}
{{- $dest := dig "backup" "destinationPath" "" $facts }}
{{- $backupOn := and $backup $dest }}
---
apiVersion: postgresql.cnpg.io/v1
kind: Cluster
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: cluster
spec:
  instances: {{ ternary 3 1 (eq (toString $ha) "true") }}
  imageCatalogRef:
    apiGroup: postgresql.cnpg.io
    kind: ClusterImageCatalog
    name: {{ $facts.imageCatalog }}
    major: {{ $version | int }}
  storage:
    size: {{ $storage }}Gi
  resources:
    requests: { cpu: {{ $res.cpu | quote }}, memory: {{ $res.memory }} }
    limits: { memory: {{ $res.limit }} }
  bootstrap:
    initdb:
      database: {{ $db }}
      owner: {{ $db }}
  inheritedMetadata:
    labels:
      platform.koorikla.io/postgresql: {{ $name }}
  {{- if $backupOn }}
  plugins:
    - name: barman-cloud.cloudnative-pg.io
      isWALArchiver: true
      parameters:
        barmanObjectName: {{ $name }}-backups
  {{- with (dig "backup" "serviceAccountAnnotations" dict $facts) }}
  serviceAccountTemplate:
    metadata:
      annotations: {{ toJson . }}
  {{- end }}
  {{- end }}
{{- if $backupOn }}
---
apiVersion: barmancloud.cnpg.io/v1
kind: ObjectStore
metadata:
  name: {{ $name }}-backups
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: object-store
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  retentionPolicy: {{ printf "%dd" $retention | quote }}
  configuration:
    destinationPath: {{ printf "%s/%s/%s/%s" (trimSuffix "/" $dest) $facts.cluster $ns $name }}
    {{- toYaml (dig "backup" "credentials" dict $facts) | nindent 4 }}
    wal:
      compression: gzip
---
apiVersion: postgresql.cnpg.io/v1
kind: ScheduledBackup
metadata:
  name: {{ $name }}-daily
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: scheduled-backup
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  schedule: "0 0 3 * * *"
  backupOwnerReference: self
  cluster:
    name: {{ $name }}
  method: plugin
  pluginConfiguration:
    name: barman-cloud.cloudnative-pg.io
{{- end }}
{{- if $facts.podMonitor }}
---
apiVersion: monitoring.coreos.com/v1
kind: PodMonitor
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: pod-monitor
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  selector:
    matchLabels:
      cnpg.io/cluster: {{ $name }}
  podMetricsEndpoints:
    - port: metrics
{{- end }}
---
apiVersion: platform.koorikla.io/v1alpha1
kind: PostgreSQL
status:
  backend: cnpg
  endpoint: {{ $name }}-rw.{{ $ns }}.svc
  port: 5432
  secretName: {{ $name }}-app
  backup: {{ if $backupOn }}enabled{{ else if $backup }}unavailable{{ else }}disabled{{ end }}
