{{- /* Shared preamble (the same in every compositions/*.gotmpl): the XR's spec with the XRD defaults as fallbacks,
the cloud-side identifier and the deletion behaviour. $facts is prepended by templates/compositions.yaml. */}}
{{- $xr := .observed.composite.resource }}
{{- $spec := $xr.spec | default dict }}
{{- $name := $xr.metadata.name }}
{{- $ns := $xr.metadata.namespace }}
{{- $version := dig "version" "17" $spec | toString }}
{{- $size := dig "size" "S" $spec }}
{{- $storage := dig "storageGiB" 10 $spec | int }}
{{- $ha := dig "highAvailability" false $spec }}
{{- $backup := dig "backup" "enabled" false $spec }}
{{- $retention := dig "backup" "retentionDays" 7 $spec | int }}
{{- $db := dig "database" "app" $spec }}
{{- $retain := eq (dig "deletionPolicy" "Retain" $spec) "Retain" }}
{{- $observed := .observed.resources | default dict }}
{{- /* Cloud identifier: unique per cluster/namespace/name, starts with a letter, <= 52 chars, no double hyphens. */}}
{{- $base := regexReplaceAll "-+" (printf "%s-%s" $ns $name | replace "." "-") "-" | trunc 40 | trimSuffix "-" }}
{{- $id := printf "pg-%s-%s" $base (sha1sum (printf "%s/%s/%s" $facts.cluster $ns $name) | trunc 8) }}
{{- /* Retain: Crossplane never deletes the cloud resource (v2 managed resources have no deletionPolicy). */}}
{{- $mp := list "*" }}
{{- if $retain }}{{ $mp = list "Observe" "Create" "Update" "LateInitialize" }}{{ end }}
{{- /* ESO template delimiters, emitted literally into ExternalSecret templates. */}}
{{- $o := "{{" }}
{{- $c := "}}" }}

{{- /* aws-rds: RDS for PostgreSQL instance (Multi-AZ when highAvailability) or Aurora PostgreSQL (spec.engine aurora),
in the cluster's VPC, reachable only from the cluster's node security group, storage encrypted with a per-database KMS
key, IAM database authentication on. The master password is generated and rotated by RDS in Secrets Manager
(manageMasterUserPassword) - it never passes through Crossplane; ESO copies it into the connection Secret. */}}
{{- $aurora := eq (dig "engine" "postgres" $spec) "aurora" }}
{{- $classes := dict "S" "db.t4g.medium" "M" "db.m7g.large" "L" "db.r7g.xlarge" }}
{{- if $aurora }}{{ $classes = dict "S" "db.t4g.medium" "M" "db.r7g.large" "L" "db.r7g.xlarge" }}{{ end }}
{{- $class := get $classes $size }}
{{- $pc := dict "kind" "ClusterProviderConfig" "name" "default" }}
{{- $tags := dict "platform.koorikla.io/cluster" $facts.cluster "platform.koorikla.io/namespace" $ns "platform.koorikla.io/postgresql" $name }}
{{- $retentionPeriod := 0 }}
{{- if $backup }}{{ $retentionPeriod = $retention }}{{ else if $aurora }}{{ $retentionPeriod = 1 }}{{ end }}
---
apiVersion: kms.aws.m.upbound.io/v1beta1
kind: Key
metadata:
  name: {{ $name }}-storage
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: kms-key
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    description: "PostgreSQL {{ $ns }}/{{ $name }} storage encryption ({{ $facts.cluster }})"
    enableKeyRotation: true
    deletionWindowInDays: 30
    tags: {{ toJson $tags }}
---
apiVersion: ec2.aws.m.upbound.io/v1beta1
kind: SecurityGroup
metadata:
  name: {{ $name }}-db
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: security-group
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    vpcId: {{ $facts.vpcId }}
    name: {{ $id }}
    description: "PostgreSQL {{ $ns }}/{{ $name }} - 5432 from the nodes of {{ $facts.cluster }} only"
    tags: {{ toJson $tags }}
---
apiVersion: ec2.aws.m.upbound.io/v1beta1
kind: SecurityGroupIngressRule
metadata:
  name: {{ $name }}-db-from-nodes
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: ingress-from-nodes
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    securityGroupIdRef:
      name: {{ $name }}-db
    referencedSecurityGroupId: {{ $facts.nodeSecurityGroupId }}
    ipProtocol: tcp
    fromPort: 5432
    toPort: 5432
    tags: {{ toJson $tags }}
---
apiVersion: rds.aws.m.upbound.io/v1beta1
kind: SubnetGroup
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: subnet-group
    crossplane.io/external-name: {{ $id }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    description: "PostgreSQL {{ $ns }}/{{ $name }} ({{ $facts.cluster }})"
    subnetIds: {{ toJson $facts.subnetIds }}
    tags: {{ toJson $tags }}
{{- $endpointKey := "instance" }}
{{- if $aurora }}
{{- $endpointKey = "cluster" }}
---
apiVersion: rds.aws.m.upbound.io/v1beta1
kind: Cluster
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: cluster
    crossplane.io/external-name: {{ $id }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    engine: aurora-postgresql
    engineVersion: {{ $version | quote }}     # major only: RDS picks the default minor (VERIFY on a live account)
    databaseName: {{ $db }}
    masterUsername: {{ $db }}
    manageMasterUserPassword: true
    iamDatabaseAuthenticationEnabled: true
    storageEncrypted: true
    kmsKeyIdRef:
      name: {{ $name }}-storage
    dbSubnetGroupNameRef:
      name: {{ $name }}
    vpcSecurityGroupIdRefs:
      - name: {{ $name }}-db
    port: 5432
    backupRetentionPeriod: {{ $retentionPeriod }}
    copyTagsToSnapshot: true
    deletionProtection: {{ $retain }}
    skipFinalSnapshot: {{ not $backup }}
    {{- if $backup }}
    finalSnapshotIdentifier: {{ $id }}-final
    {{- end }}
    tags: {{ toJson $tags }}
{{- /* Writer, plus a reader in another AZ (Aurora fails over to it) when highAvailability. */}}
{{- range $i := until (ternary 2 1 (eq (toString $ha) "true")) }}
---
apiVersion: rds.aws.m.upbound.io/v1beta1
kind: ClusterInstance
metadata:
  name: {{ $name }}-{{ $i }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: cluster-instance-{{ $i }}
    crossplane.io/external-name: {{ $id }}-{{ $i }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    engine: aurora-postgresql
    instanceClass: {{ $class }}
    clusterIdentifierRef:
      name: {{ $name }}
    dbSubnetGroupNameRef:
      name: {{ $name }}
    publiclyAccessible: false
    autoMinorVersionUpgrade: true
    promotionTier: {{ $i }}
    tags: {{ toJson $tags }}
{{- end }}
{{- else }}
---
apiVersion: rds.aws.m.upbound.io/v1beta1
kind: Instance
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: instance
    crossplane.io/external-name: {{ $id }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    region: {{ $facts.region }}
    engine: postgres
    engineVersion: {{ $version | quote }}     # major only: RDS picks the default minor, autoMinorVersionUpgrade keeps it current
    autoMinorVersionUpgrade: true
    instanceClass: {{ $class }}
    multiAz: {{ $ha }}
    allocatedStorage: {{ $storage }}
    maxAllocatedStorage: {{ mul $storage 2 }}
    storageType: gp3
    storageEncrypted: true
    kmsKeyIdRef:
      name: {{ $name }}-storage
    dbName: {{ $db }}
    username: {{ $db }}
    manageMasterUserPassword: true
    iamDatabaseAuthenticationEnabled: true
    dbSubnetGroupNameRef:
      name: {{ $name }}
    vpcSecurityGroupIdRefs:
      - name: {{ $name }}-db
    publiclyAccessible: false
    port: 5432
    backupRetentionPeriod: {{ $retentionPeriod }}
    copyTagsToSnapshot: true
    deletionProtection: {{ $retain }}
    skipFinalSnapshot: {{ not $backup }}
    {{- if $backup }}
    finalSnapshotIdentifier: {{ $id }}-final
    {{- end }}
    tags: {{ toJson $tags }}
{{- end }}
{{- /* Connection Secret, once RDS reports the endpoint and the Secrets Manager ARN of the managed master secret. */}}
{{- $at := dig $endpointKey "resource" "status" "atProvider" dict $observed }}
{{- $host := ternary (dig "endpoint" "" $at) (dig "address" "" $at) $aurora }}
{{- $secretArn := "" }}
{{- with (dig "masterUserSecret" list $at) }}{{ $secretArn = dig "secretArn" "" (first .) }}{{ end }}
{{- if and $host $secretArn }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: connection-secret
spec:
  refreshInterval: 1h                   # RDS rotates the master secret (default every 7 days)
  secretStoreRef:
    kind: ClusterSecretStore
    name: default
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "5432"
        dbname: {{ $db }}
        username: '{{ $o }} .username {{ $c }}'
        password: '{{ $o }} .password {{ $c }}'
        uri: 'postgresql://{{ $o }} .username | urlquery {{ $c }}:{{ $o }} .password | urlquery {{ $c }}@{{ $host }}:5432/{{ $db }}?sslmode=require'
  data:
    - secretKey: username
      remoteRef: { key: {{ $secretArn }}, property: username }
    - secretKey: password
      remoteRef: { key: {{ $secretArn }}, property: password }
{{- end }}
---
apiVersion: platform.koorikla.io/v1alpha1
kind: PostgreSQL
status:
  backend: aws-rds
  backup: {{ ternary "enabled" "disabled" (eq (toString $backup) "true") }}
  {{- if $host }}
  endpoint: {{ $host }}
  port: 5432
  {{- end }}
  {{- if and $host $secretArn }}
  secretName: {{ $name }}-app
  {{- end }}
