{{- /* Shared preamble (the same in every compositions/*.gotmpl): the XR's spec with the XRD defaults as fallbacks,
the cloud-side identifier and the deletion behaviour. $facts is prepended by templates/compositions.yaml. */}}
{{- $xr := .observed.composite.resource }}
{{- $spec := $xr.spec | default dict }}
{{- $name := $xr.metadata.name }}
{{- $ns := $xr.metadata.namespace }}
{{- $version := dig "version" "17" $spec | toString }}
{{- $size := dig "size" "S" $spec }}
{{- $storage := dig "storageGiB" 10 $spec | int }}
{{- $ha := dig "highAvailability" false $spec }}
{{- $backup := dig "backup" "enabled" false $spec }}
{{- $retention := dig "backup" "retentionDays" 7 $spec | int }}
{{- $db := dig "database" "app" $spec }}
{{- $retain := eq (dig "deletionPolicy" "Retain" $spec) "Retain" }}
{{- $observed := .observed.resources | default dict }}
{{- /* Cloud identifier: unique per cluster/namespace/name, starts with a letter, <= 52 chars, no double hyphens. */}}
{{- $base := regexReplaceAll "-+" (printf "%s-%s" $ns $name | replace "." "-") "-" | trunc 40 | trimSuffix "-" }}
{{- $id := printf "pg-%s-%s" $base (sha1sum (printf "%s/%s/%s" $facts.cluster $ns $name) | trunc 8) }}
{{- /* Retain: Crossplane never deletes the cloud resource (v2 managed resources have no deletionPolicy). */}}
{{- $mp := list "*" }}
{{- if $retain }}{{ $mp = list "Observe" "Create" "Update" "LateInitialize" }}{{ end }}
{{- /* ESO template delimiters, emitted literally into ExternalSecret templates. */}}
{{- $o := "{{" }}
{{- $c := "}}" }}

{{- /* gcp-cloudsql: Cloud SQL for PostgreSQL, private IP only in the cluster's VPC, TLS required, IAM database
authentication on, REGIONAL (synchronous standby in another zone) when highAvailability. The owner role's password is
generated in-cluster by an ESO Password generator into the connection Secret; Crossplane's pipeline never sees it (the
provider reads it from the Secret to set it on the user). */}}
{{- $tiers := dict "S" "db-custom-1-3840" "M" "db-custom-2-7680" "L" "db-custom-4-15360" }}
{{- $pc := dict "kind" "ClusterProviderConfig" "name" "default" }}
{{- $labels := dict "platform-koorikla-io-cluster" $facts.cluster "platform-koorikla-io-namespace" $ns "platform-koorikla-io-postgresql" ($name | replace "." "-") }}
---
apiVersion: sql.gcp.m.upbound.io/v1beta1
kind: DatabaseInstance
metadata:
  name: {{ $name }}
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: instance
    crossplane.io/external-name: {{ $id }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    project: {{ $facts.project }}
    region: {{ $facts.region }}
    databaseVersion: POSTGRES_{{ $version }}
    deletionProtection: {{ $retain }}
    settings:
      edition: ENTERPRISE
      tier: {{ get $tiers $size }}
      availabilityType: {{ ternary "REGIONAL" "ZONAL" (eq (toString $ha) "true") }}
      diskType: PD_SSD
      diskSize: {{ $storage }}
      diskAutoresize: true
      deletionProtectionEnabled: {{ $retain }}
      ipConfiguration:
        ipv4Enabled: false
        privateNetwork: {{ $facts.privateNetwork }}
        {{- with $facts.allocatedIpRange }}
        allocatedIpRange: {{ . }}
        {{- end }}
        sslMode: ENCRYPTED_ONLY
      backupConfiguration:
        enabled: {{ $backup }}
        pointInTimeRecoveryEnabled: {{ $backup }}
        {{- if $backup }}
        transactionLogRetentionDays: {{ min $retention 7 }}
        backupRetentionSettings:
          retainedBackups: {{ $retention }}
          retentionUnit: COUNT
        {{- end }}
      databaseFlags:
        - name: cloudsql.iam_authentication
          value: "on"
      userLabels: {{ toJson $labels }}
---
apiVersion: sql.gcp.m.upbound.io/v1beta1
kind: Database
metadata:
  name: {{ $name }}-db
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: database
    crossplane.io/external-name: {{ $db }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    project: {{ $facts.project }}
    instanceRef:
      name: {{ $name }}
---
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: {{ $name }}-password
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: password-generator
    gotemplating.fn.crossplane.io/ready: "True"
spec:
  length: 32
  digits: 8
  symbols: 0                          # URI-safe without escaping
  noUpper: false
  allowRepeat: true
{{- /* Connection Secret once the private IP is known; generated once (CreatedOnce): deleting the Secret rotates the
password (a new one is generated and the provider applies it to the user). */}}
{{- $host := dig "instance" "resource" "status" "atProvider" "privateIpAddress" "" $observed }}
{{- if $host }}
---
apiVersion: external-secrets.io/v1
kind: ExternalSecret
metadata:
  name: {{ $name }}-app
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: connection-secret
spec:
  refreshPolicy: CreatedOnce
  target:
    name: {{ $name }}-app
    creationPolicy: Owner
    template:
      engineVersion: v2
      type: Opaque
      data:
        host: {{ $host }}
        port: "5432"
        dbname: {{ $db }}
        username: {{ $db }}
        password: '{{ $o }} .password {{ $c }}'
        uri: 'postgresql://{{ $db }}:{{ $o }} .password {{ $c }}@{{ $host }}:5432/{{ $db }}?sslmode=require'
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: {{ $name }}-password
---
apiVersion: sql.gcp.m.upbound.io/v1beta1
kind: User
metadata:
  name: {{ $name }}-owner
  annotations:
    gotemplating.fn.crossplane.io/composition-resource-name: user
    crossplane.io/external-name: {{ $db }}
spec:
  managementPolicies: {{ toJson $mp }}
  providerConfigRef: {{ toJson $pc }}
  forProvider:
    project: {{ $facts.project }}
    instanceRef:
      name: {{ $name }}
    passwordSecretRef:
      name: {{ $name }}-app
      key: password
{{- end }}
---
apiVersion: platform.koorikla.io/v1alpha1
kind: PostgreSQL
status:
  backend: gcp-cloudsql
  backup: {{ ternary "enabled" "disabled" (eq (toString $backup) "true") }}
  {{- if $host }}
  endpoint: {{ $host }}
  port: 5432
  secretName: {{ $name }}-app
  {{- end }}
