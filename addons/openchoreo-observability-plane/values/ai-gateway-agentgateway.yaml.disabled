# Disabled overlay for OpenChoreo `ai-gateway-agentgateway` module (agentgateway v1.1.0 + agentgateway-crds v1.1.0).
# Runs on mgmt alongside openchoreo-observability-plane so RCA and FinOps agents reach the AI gateway in-cluster.
# To enable: see docs/ai-agents.md (uncomment agentgateway{,-crds} in Chart.yaml, add oci://cr.agentgateway.dev/* to
# AppProject platform, merge these values into values.yaml or installations/<inst>/addons/openchoreo-observability-plane/values.yaml,
# or promote to a dedicated addons/agentgateway addon).

aiGateway:
  enabled: true                # enables templates/ai-gateway-agentgateway.yaml (Gateway + AgentgatewayBackend + HTTPRoute + Secret)

# agentgateway controller + GatewayClass `agentgateway` (upstream oci://cr.agentgateway.dev/charts/agentgateway v1.1.0)
agentgateway:
  gateway:
    enabled: false             # templates/ai-gateway-agentgateway.yaml creates Gateway `agentgateway-proxy`
  controller:
    image:
      registry: cr.agentgateway.dev
      repository: agentgateway-controller
      tag: v1.1.0
    resources:
      requests: { cpu: 25m, memory: 64Mi }
      limits: { cpu: 200m, memory: 256Mi }
  proxy:
    image:
      registry: cr.agentgateway.dev
      repository: agentgateway-proxy
      tag: v1.1.0
  deployment:
    resources:
      requests: { cpu: 25m, memory: 64Mi }
      limits: { cpu: 200m, memory: 256Mi }

# Point RCA and FinOps agents at the in-cluster agentgateway proxy:
openchoreo-observability-plane:
  rca:
    llm:
      modelName: "gpt-4o"
      baseUrl: "http://agentgateway-proxy.openchoreo-observability-plane.svc.cluster.local/openai/v1"
      auth: "api_key"
  finOpsAgent:
    llmName: "gpt-4o"
    llmBaseUrl: "http://agentgateway-proxy.openchoreo-observability-plane.svc.cluster.local/openai/v1"
    llmAuth: "api_key"
