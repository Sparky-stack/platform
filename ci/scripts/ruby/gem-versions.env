# Versions check.sh installs when Gemfile.lock does not pin the gem (a lockfile pin always wins).
# Renovate keeps them current (renovate.json, "# renovate:" annotations).
# renovate: datasource=rubygems depName=brakeman
BRAKEMAN_VERSION=8.1.1
# renovate: datasource=rubygems depName=bundler-audit
BUNDLER_AUDIT_VERSION=0.9.3
