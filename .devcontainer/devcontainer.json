{
  "name": "koorikla-platform",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.9-ubuntu24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": true
    }
  },
  "containerEnv": {
    "MISE_YES": "1",
    "MISE_VERSION": "v2026.11.8"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "64gb"
  },
  "forwardPorts": [8080, 8081, 11080],
  "portsAttributes": {
    "8080": { "label": "OpenChoreo console / API / Thunder (*.openchoreo.localhost:8080)" },
    "8081": { "label": "Argo CD UI (task ui)" },
    "11080": { "label": "OpenChoreo observer" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "timonwong.shellcheck",
        "task.vscode-task",
        "hverlin.mise-vscode"
      ]
    }
  }
}
